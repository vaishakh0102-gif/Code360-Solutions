#include <vector>
#include <algorithm>

using namespace std;

bool compareJobs(const vector<int>& a, const vector<int>& b) {
    return a[2] > b[2];
}

vector<int> jobScheduling(vector<vector<int>>& jobs) {
    int n = jobs.size();
    
    sort(jobs.begin(), jobs.end(), compareJobs);
    
    int maxdead = -1;
    for (int i = 0; i < n; i++) {
        maxdead = max(maxdead, jobs[i][1]);
    }
    
    vector<int> slot(maxdead + 1, -1);
    
    int cntjobs = 0;
    int totprofit = 0;
    
    for (int i = 0; i < n; i++) {
        int deadline = jobs[i][1];
        int profit = jobs[i][2];
        
        for (int j = deadline; j > 0; j--) {
            if (slot[j] == -1) {
                slot[j] = jobs[i][0];
                cntjobs++;
                totprofit += profit;
                break;
            }
        }
    }
    
    return {cntjobs, totprofit};
}
