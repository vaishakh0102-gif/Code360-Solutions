int count(vector<vector<int>> &matrix, int m, int n,int x){
    int cnt=0;
    for(int i=0;i<m;i++){
        
        cnt += upper_bound(matrix[i].begin(), matrix[i].end(), x) - matrix[i].begin();
    }
    return cnt;
}
int median(vector<vector<int>> &matrix, int m, int n) {
    int low=INT_MAX,high=INT_MIN;
    for(int i=0;i<m;i++){
        low=min(low,matrix[i][0]);
        high=max(high,matrix[i][n-1]);
    }
    while(low<=high){
        int mid=(low+high)/2;
        int req=(n*m)/2;
        int smlEql=count(matrix,m,n,mid);
        if (smlEql<=req)low=mid+1;
        else high=mid-1;
        
    }
    return low;

}v
