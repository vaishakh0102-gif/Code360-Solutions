int count(vector<int>& arr, int n, int x) {
	

   
    int low=0,high=n-1;
    vector<int>ans={-1,-1};
    while(low<=high){
        int mid=(low+high)/2;
        if (arr[mid]==x){
            ans[0]=mid;
            high=mid-1;
        }
        else if (arr[mid]>x)high=mid-1;
        else low=mid+1;
    } 

    if (ans[0]==-1)return 0;

        
    low=0,high=n-1;
    while(low<=high){
        int mid=(low+high)/2;
        if (arr[mid]==x){
            ans[1]=mid;
            low=mid+1;

        }
        else if (arr[mid]>x)high=mid-1;
        else low=mid+1;
    }     
    return (ans[1]-ans[0]+1);





	
}
