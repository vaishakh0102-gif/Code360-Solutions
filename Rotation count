#include <climits>
int findKRotation(vector<int> &arr){
        int n=arr.size();
        int low=0,high=n-1;
        int mini=INT_MAX;
        int index=-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(arr[low]<=arr[mid]){
                if(arr[low]<mini){
                    mini=arr[low];
                    index=low;
                }
                low=mid+1;
            }
            else{
               
                if (arr[mid]<mini){
                    mini=arr[mid];
                    index=mid;
                }
                high=mid-1;
                


            }
            
        }
        return index;
    
    
    
}
